# The user and group the apps run as, which own your media: `id` shows yours.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Where each app keeps its settings, a folder of its own in this one.
CONFIG=./config

# The folder all the apps share as /data, holding usenet/, torrents/ and
# media/. Downloads and the library must be on the same disk for imports to
# be hardlinks.
DATA=/srv/data
